# ────────────────────────────────────────────────────────────────────────────
# Task Management System — Environment Variable Reference
# ────────────────────────────────────────────────────────────────────────────
#
# USAGE
#   Copy this file to .env and fill in the values for your environment.
#   .env is listed in .gitignore — NEVER commit .env.
#
#   Load into the shell (Linux / macOS / WSL):
#     export $(grep -v '^#' .env | grep -v '^$' | xargs)
#
#   Or pass directly to Gradle:
#     DB_URL=... APP_JWT_SECRET=... ./gradlew bootRun --args='--spring.profiles.active=dev'
#
#   Or add them to your IDE run configuration's environment section.
#
# PROFILES
#   dev  — local development (MySQL via docker-compose)
#   prod — production / staging (all defaults removed, no fallbacks)
#
# REQUIRED vs OPTIONAL
#   Variables marked REQUIRED have no default and will cause the application
#   to fail on startup if absent.  Variables marked OPTIONAL have a default
#   documented in the comment next to them.
# ────────────────────────────────────────────────────────────────────────────

# ── Spring profile ────────────────────────────────────────────────────────────
# REQUIRED — selects which application-{profile}.properties file to load.
# Values: dev | prod
SPRING_PROFILES_ACTIVE=dev

# ── Database ──────────────────────────────────────────────────────────────────
# REQUIRED — full JDBC connection URL.
#
# Dev (matches docker-compose.yml defaults):
#   DB_URL=jdbc:mysql://localhost:3306/task_management_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
#
# Production (TLS enforced, no auto-create):
#   DB_URL=jdbc:mysql://db.internal:3306/task_management_db?useSSL=true&requireSSL=true&serverTimezone=UTC
DB_URL=jdbc:mysql://localhost:3306/task_management_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true

# REQUIRED — database username.
# Dev default (matches docker-compose.yml): taskuser
# Production: use a dedicated, least-privilege application account.
DB_USERNAME=taskuser

# REQUIRED — database password.
# Dev default (matches docker-compose.yml): taskpassword
# Production: use a strong, randomly generated password from a secrets manager.
DB_PASSWORD=taskpassword

# ── JWT ───────────────────────────────────────────────────────────────────────
# REQUIRED — Base64-encoded HMAC-SHA256 signing key.
# Must decode to at least 32 bytes (256 bits).
#
# Generate a suitable key:
#   openssl rand -base64 32
#
# NEVER reuse the same key across environments.
# NEVER commit this value to version control.
APP_JWT_SECRET=REPLACE_ME_WITH_OUTPUT_OF_openssl_rand_-base64_32

# OPTIONAL — JWT token lifetime in milliseconds. Default: 86400000 (24 hours).
# Shorter lifetimes reduce the blast radius of a leaked token.
# Production recommendation: 3600000 (1 hour).
APP_JWT_EXPIRATION_MS=86400000

# ── Server ────────────────────────────────────────────────────────────────────
# OPTIONAL — HTTP port the application listens on. Default: 8080.
# SERVER_PORT=8080

# ── HikariCP pool sizing ──────────────────────────────────────────────────────
# OPTIONAL — Override the pool size from application-{profile}.properties.
# Useful when multiple replicas share a single DB instance.
# SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=20
# SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE=5

# ── Task pagination ───────────────────────────────────────────────────────────
# OPTIONAL — Maximum tasks per page (default: 100). Prevents runaway queries.
# APP_TASKS_MAX_PAGE_SIZE=100
